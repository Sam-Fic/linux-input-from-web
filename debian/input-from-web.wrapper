#!/usr/bin/env bash
set -euo pipefail

# Ensure ydotoold is running (needs /dev/uinput access)
if ! pgrep -x ydotoold > /dev/null 2>&1; then
    echo "Starting ydotoold (requires sudo for /dev/uinput)..."
    sudo ydotoold &
    sleep 0.5
    echo "ydotoold started."
fi

export PYTHONPATH="/usr/share/input-from-web${PYTHONPATH:+:$PYTHONPATH}"
exec /usr/bin/python3 -m input_from_web "$@"
